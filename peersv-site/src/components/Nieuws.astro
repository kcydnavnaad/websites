---
import { getFacebookPosts } from '../lib/facebook';
import NieuwsKaart from './NieuwsKaart.astro';

const posts = await getFacebookPosts();
const visible = posts.slice(0, 3);
const hasMore = posts.length > 3;
---

{
  posts.length > 0 && (
    <section id="nieuws" class="section section-dark">
      <div class="container-x">
        <div class="max-w-2xl">
          <span class="eyebrow text-club-yellow">Nieuws</span>
          <h2 class="section-title mt-4 text-white">Van de club.</h2>
          <span class="accent-bar mt-6" />
          <p class="mt-6 text-lg text-white/80">
            Blijf op de hoogte van alles wat er leeft bij de club.
          </p>
        </div>

        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {visible.map((post) => (
            <NieuwsKaart post={post} />
          ))}
        </ul>

        {hasMore && (
          <div class="mt-12 flex justify-center">
            <a href="/nieuws" class="btn-outline-light">
              Alle nieuwsberichten
              <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )
}
