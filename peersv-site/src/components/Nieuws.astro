---
import { getFacebookPosts } from '../lib/facebook';

const posts = await getFacebookPosts();

const dateFormatter = new Intl.DateTimeFormat('nl-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{
  posts.length > 0 && (
    <section id="nieuws" class="section section-dark">
      <div class="container-x">
        <div class="max-w-2xl">
          <span class="eyebrow text-club-yellow">Nieuws</span>
          <h2 class="section-title mt-4 text-white">Van de club.</h2>
          <span class="accent-bar mt-6" />
          <p class="mt-6 text-lg text-white/80">
            Onze laatste updates, rechtstreeks van onze Facebook-pagina.
          </p>
        </div>

        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-anthracite transition-all duration-200 hover:-translate-y-0.5 hover:border-white/25">
              {post.full_picture && (
                <a
                  href={post.permalink_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="relative block aspect-[16/10] overflow-hidden bg-ink-deep"
                  aria-label={`Facebook-post: ${post.title}`}
                >
                  <img
                    src={post.full_picture}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-6">
                <time
                  datetime={post.created_time}
                  class="text-xs font-bold uppercase tracking-[0.22em] text-club-yellow"
                >
                  {dateFormatter.format(new Date(post.created_time))}
                </time>
                <h3 class="mt-3 text-lg font-extrabold tracking-tight text-white">
                  {post.title}
                </h3>
                {post.excerpt !== post.title && (
                  <p class="mt-3 text-sm leading-relaxed text-white/70">
                    {post.excerpt}
                  </p>
                )}
                <a
                  href={post.permalink_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-white transition hover:text-club-red"
                >
                  Lees meer op Facebook
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
