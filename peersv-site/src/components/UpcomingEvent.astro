---
import {
  getActiveEvent,
  isRegistrationOpen,
  registrationOpensLabel,
} from '../lib/events';

const event = getActiveEvent();
const open = event ? isRegistrationOpen(event) : false;
---

{
  event && (
    <section id={event.slug} class="relative isolate overflow-hidden bg-ink-deep text-white">
      <div
        class="pointer-events-none absolute -right-24 -top-24 -z-10 h-80 w-80 rotate-12 bg-club-yellow/15 blur-3xl"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute -left-24 -bottom-24 -z-10 h-80 w-80 -rotate-12 bg-club-red/40 blur-3xl"
        aria-hidden="true"
      />

      <div class="container-x relative py-14 sm:py-16">
        <div class="grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
          <div>
            <span class="eyebrow text-club-yellow">
              <span class="h-px w-8 bg-club-yellow" />
              {event.kicker}
            </span>
            <h2 class="display mt-5 text-4xl text-white sm:text-5xl lg:text-6xl">
              {event.title}
            </h2>
            <p class="mt-4 text-xl font-semibold text-club-yellow sm:text-2xl">{event.dates}</p>
            <p class="mt-5 max-w-xl text-base text-white/80 sm:text-lg">{event.description}</p>
            <p class="mt-3 text-sm text-white/60">{event.location}</p>
          </div>

          <div class="card-dark flex flex-col gap-4 border-white/15 bg-anthracite/80 p-7 backdrop-blur">
            {open ? (
              <>
                <p class="text-sm font-semibold uppercase tracking-[0.22em] text-club-yellow">
                  Inschrijvingen open
                </p>
                <p class="text-white/85">
                  Reserveer je plaats en bestel vooraf. Je inschrijving is na online betaling
                  meteen in orde.
                </p>
                <a href={`/${event.slug}`} class="btn-primary mt-2 w-full">
                  Inschrijven &amp; bestellen
                  <span aria-hidden="true">→</span>
                </a>
              </>
            ) : (
              <>
                <p class="text-sm font-semibold uppercase tracking-[0.22em] text-club-yellow">
                  Binnenkort
                </p>
                <p class="text-white/85">
                  De online inschrijvingen openen op{' '}
                  <b class="text-white">{registrationOpensLabel(event)}</b>. Bekijk nu al het
                  programma.
                </p>
                <a href={`/${event.slug}`} class="btn-outline-light mt-2 w-full">
                  Bekijk het programma
                  <span aria-hidden="true">→</span>
                </a>
              </>
            )}
            <p class="text-xs text-white/50">
              Lukt online inschrijven niet? Mail naar{' '}
              <a href="mailto:info@kpeersv.be" class="underline hover:text-club-yellow">
                info@kpeersv.be
              </a>
              .
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}
