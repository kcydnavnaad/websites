---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ICS_URL =
  'https://teampoint.webbaas.be/api/calendar/club/a37ad9ed176060e137d869178e7de42c.ics';
const JSON_URL =
  'https://teampoint.webbaas.be/api/calendar/events.json?token=a37ad9ed176060e137d869178e7de42c';
---

<Layout
  title="Kalender — K. Peer SV"
  description="Alle trainingen, wedstrijden, tornooien en evenementen van K. Peer SV."
  canonical="https://kpeersv.be/kalender"
>
  <Header />
  <main id="main" class="bg-ink-deep text-white">
    <section class="relative isolate overflow-hidden bg-ink-deep">
      <div
        class="pointer-events-none absolute -right-24 -top-24 -z-10 h-[420px] w-[420px] rounded-full bg-club-yellow/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -left-24 top-40 -z-10 h-72 w-[120%] -rotate-3 bg-gradient-to-r from-club-red/25 via-club-red/5 to-transparent blur-2xl"
        aria-hidden="true"
      >
      </div>

      <div class="container-x pt-40 pb-12 sm:pt-48 sm:pb-16">
        <div class="max-w-3xl">
          <span
            class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.32em] text-club-yellow"
          >
            <span class="h-px w-8 bg-club-yellow"></span>
            Kalender
          </span>

          <h1 class="display mt-6 text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">
            Kalender seizoen 2026-2027
          </h1>

          <span class="mt-6 block h-1.5 w-24 rounded-full bg-club-yellow"></span>

          <p class="mt-8 max-w-2xl text-lg text-white/80">
            Alle trainingen, wedstrijden, tornooien en evenementen van
            K. Peer SV.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 sm:pb-32">
      <div class="container-x space-y-8">
        <div class="rounded-2xl border border-white/10 bg-anthracite p-6 sm:p-8">
          <h2 class="text-xl font-semibold text-white">Voeg toe aan je agenda</h2>
          <p class="mt-2 text-sm text-white/80">
            Krijg alle events automatisch in je iPhone-, Google- of Outlook-agenda.
          </p>

          <details class="mt-4 text-sm text-white/85">
            <summary
              class="cursor-pointer font-medium text-club-yellow hover:text-club-yellow/80"
            >
              Instructies bekijken
            </summary>

            <div class="mt-6 space-y-6">
              <div>
                <h3 class="font-semibold text-white">iPhone (Agenda-app)</h3>
                <ol class="mt-2 list-decimal space-y-1 pl-5 text-white/80">
                  <li>Open <strong>Instellingen</strong> op je iPhone</li>
                  <li>
                    Ga naar <strong>Agenda → Accounts → Voeg account toe</strong>
                  </li>
                  <li>
                    Kies <strong>Andere → Voeg abonnementsagenda toe</strong>
                  </li>
                  <li>
                    Plak deze URL:
                    <code
                      class="mt-1 inline-block break-all rounded bg-black/40 px-2 py-1 text-xs text-club-yellow"
                    >
                      {ICS_URL}
                    </code>
                  </li>
                </ol>
              </div>

              <div>
                <h3 class="font-semibold text-white">Google Calendar</h3>
                <ol class="mt-2 list-decimal space-y-1 pl-5 text-white/80">
                  <li>
                    Open
                    <a
                      href="https://calendar.google.com"
                      class="text-club-yellow underline hover:text-club-yellow/80"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Calendar
                    </a>
                  </li>
                  <li>
                    Klik op het <strong>+</strong> naast "Andere agenda's"
                  </li>
                  <li>Kies <strong>Via URL</strong></li>
                  <li>Plak dezelfde URL en klik <strong>Agenda toevoegen</strong></li>
                </ol>
              </div>

              <div>
                <h3 class="font-semibold text-white">Outlook</h3>
                <ol class="mt-2 list-decimal space-y-1 pl-5 text-white/80">
                  <li>Open Outlook → <strong>Agenda</strong></li>
                  <li>
                    Klik <strong>Agenda toevoegen → Vanaf internet</strong>
                  </li>
                  <li>Plak dezelfde URL</li>
                </ol>
              </div>
            </div>
          </details>
        </div>

        <div class="rounded-2xl border border-white/10 bg-anthracite p-4 sm:p-6">
          <div id="calendar"></div>
        </div>

        <div>
          <a href="/" class="btn-outline-light">
            <span aria-hidden="true">←</span>
            Terug naar home
          </a>
        </div>
      </div>
    </section>
  </main>

  <div
    id="event-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="event-modal-title"
  >
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-anthracite p-6 shadow-2xl">
      <div class="mb-4 flex items-start justify-between gap-4">
        <h3 id="event-modal-title" class="text-xl font-semibold text-white"></h3>
        <button
          id="event-modal-close"
          type="button"
          class="flex-none text-white/50 transition-colors hover:text-white"
          aria-label="Sluiten"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <dl class="space-y-3 text-sm">
        <div>
          <dt class="mb-1 text-xs uppercase tracking-wide text-white/50">Wanneer</dt>
          <dd id="event-modal-when" class="text-white"></dd>
        </div>
        <div id="event-modal-location-wrap" class="hidden">
          <dt class="mb-1 text-xs uppercase tracking-wide text-white/50">Locatie</dt>
          <dd id="event-modal-location" class="text-white"></dd>
        </div>
        <div id="event-modal-description-wrap" class="hidden">
          <dt class="mb-1 text-xs uppercase tracking-wide text-white/50">Extra info</dt>
          <dd id="event-modal-description" class="whitespace-pre-line text-white"></dd>
        </div>
      </dl>
    </div>
  </div>

  <link
    href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css"
    rel="stylesheet"
  />
  <script
    src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"
    is:inline
  ></script>
  <script is:inline define:vars={{ apiUrl: JSON_URL }}>
    document.addEventListener('DOMContentLoaded', function () {
      // --- Event-detail modal ---
      const modal = document.getElementById('event-modal');
      const titleEl = document.getElementById('event-modal-title');
      const whenEl = document.getElementById('event-modal-when');
      const locWrap = document.getElementById('event-modal-location-wrap');
      const locEl = document.getElementById('event-modal-location');
      const descWrap = document.getElementById('event-modal-description-wrap');
      const descEl = document.getElementById('event-modal-description');
      const closeBtn = document.getElementById('event-modal-close');

      let lastFocused = null;

      function openModal() {
        lastFocused = document.activeElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (closeBtn) closeBtn.focus();
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      }

      if (modal) {
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
          }
        });
      }

      const calendarEl = document.getElementById('calendar');
      if (!calendarEl || typeof FullCalendar === 'undefined') return;

      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'nl',
        firstDay: 1,
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,listMonth',
        },
        buttonText: {
          today: 'Vandaag',
          month: 'Maand',
          list: 'Lijst',
        },
        events: apiUrl,
        eventDidMount: function (info) {
          const colors = {
            training: '#d72638',
            tournament: '#eab308',
            match: '#3b82f6',
            other: '#22c55e',
          };
          const type = (info.event.extendedProps || {}).type;
          const color = colors[type] || '#d72638';

          // Lijstweergave toont een gekleurde stip i.p.v. een gevuld blok
          const dot = info.el.querySelector('.fc-list-event-dot');
          if (dot) {
            dot.style.borderColor = color;
          } else {
            info.el.style.backgroundColor = color;
            info.el.style.borderColor = color;
          }
        },
        eventClick: function (info) {
          info.jsEvent.preventDefault();
          if (!modal) return;

          titleEl.textContent = info.event.title;

          // Datum/tijd formatteren
          const start = info.event.start;
          const end = info.event.end;
          const allDay = info.event.allDay;

          if (!start) {
            whenEl.textContent = '';
          } else if (allDay) {
            const dateOpts = {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            };
            // FullCalendar zet het einde van een all-day event op de dag ná de laatste dag
            const endInclusive = end ? new Date(end.getTime() - 86400000) : null;
            if (endInclusive && endInclusive.toDateString() !== start.toDateString()) {
              whenEl.textContent =
                start.toLocaleDateString('nl-BE', dateOpts) +
                ' t/m ' +
                endInclusive.toLocaleDateString('nl-BE', dateOpts);
            } else {
              whenEl.textContent = start.toLocaleDateString('nl-BE', dateOpts);
            }
          } else {
            const dateOpts = { weekday: 'long', day: 'numeric', month: 'long' };
            const timeOpts = { hour: '2-digit', minute: '2-digit' };
            const startStr =
              start.toLocaleDateString('nl-BE', dateOpts) +
              ' · ' +
              start.toLocaleTimeString('nl-BE', timeOpts);
            const endStr = end ? end.toLocaleTimeString('nl-BE', timeOpts) : '';
            whenEl.textContent = endStr ? startStr + ' – ' + endStr : startStr;
          }

          const props = info.event.extendedProps || {};

          if (props.location) {
            locEl.textContent = props.location;
            locWrap.classList.remove('hidden');
          } else {
            locWrap.classList.add('hidden');
          }

          if (props.description) {
            descEl.textContent = props.description;
            descWrap.classList.remove('hidden');
          } else {
            descWrap.classList.add('hidden');
          }

          openModal();
        },
        eventColor: '#d72638',
        height: 'auto',
      });
      calendar.render();
    });
  </script>

  <Footer />
</Layout>

<style is:global>
  /* FullCalendar dark theme override — matcht kpeersv.be huisstijl */
  #calendar {
    --fc-border-color: rgba(255, 255, 255, 0.1);
    --fc-page-bg-color: transparent;
    --fc-neutral-bg-color: rgba(255, 255, 255, 0.05);
    --fc-list-event-hover-bg-color: rgba(255, 255, 255, 0.05);
    --fc-today-bg-color: rgba(249, 200, 14, 0.08);
    --fc-event-bg-color: #d72638;
    --fc-event-border-color: #d72638;
    --fc-event-text-color: #ffffff;
    --fc-button-bg-color: rgba(255, 255, 255, 0.08);
    --fc-button-border-color: rgba(255, 255, 255, 0.1);
    --fc-button-hover-bg-color: rgba(255, 255, 255, 0.15);
    --fc-button-hover-border-color: rgba(255, 255, 255, 0.2);
    --fc-button-active-bg-color: rgba(249, 200, 14, 0.2);
    --fc-button-active-border-color: rgba(249, 200, 14, 0.4);
    color: #ffffff;
  }

  /* Header toolbar */
  #calendar .fc-toolbar-title {
    color: #ffffff;
    font-weight: 600;
  }

  /* Day headers (ma, di, wo...) */
  #calendar .fc-col-header-cell {
    background-color: rgba(255, 255, 255, 0.05);
  }
  #calendar .fc-col-header-cell-cushion {
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.5rem;
  }

  /* Day numbers */
  #calendar .fc-daygrid-day-number {
    color: rgba(255, 255, 255, 0.9);
    padding: 0.5rem;
  }

  /* Dagen buiten de huidige maand dimmen */
  #calendar .fc-day-other .fc-daygrid-day-number {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Event styling */
  #calendar .fc-daygrid-event {
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.75rem;
    border: none;
  }

  /* Tijd-tekst van events */
  #calendar .fc-event-time {
    font-weight: 600;
    margin-right: 4px;
  }

  /* Lijstweergave */
  #calendar .fc-list-day-cushion {
    background-color: rgba(255, 255, 255, 0.05) !important;
  }
  #calendar .fc-list-event:hover td {
    background-color: rgba(255, 255, 255, 0.05) !important;
  }
  #calendar .fc-list-empty {
    background: transparent;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Buttons */
  #calendar .fc-button {
    color: #ffffff;
    text-transform: capitalize;
    box-shadow: none;
  }

  /* Vandaag-indicator */
  #calendar .fc-day-today {
    background-color: rgba(249, 200, 14, 0.08) !important;
  }
</style>
