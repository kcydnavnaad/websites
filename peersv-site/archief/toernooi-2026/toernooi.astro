    background: var(--anthra);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--txt);
    transition: 0.15s;
  }
  .toernooi .chip i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--acc);
    flex: 0 0 auto;
  }
