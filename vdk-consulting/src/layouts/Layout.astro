---
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "VDK-Consulting: IT-oplossingen voor moderne ondernemingen. Webdesign, netwerkinfrastructuur en IT consultancy in België.",
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="grid-bg" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="VDK-Consulting home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">VDK<span class="brand-dash">-</span>Consulting</span>
        </a>
        <nav aria-label="Hoofdnavigatie">
          <ul>
            <li><a href="/" class:list={[{ active: path === "/" }]}>Home</a></li>
            <li><a href="/diensten" class:list={[{ active: path.startsWith("/diensten") }]}>Diensten</a></li>
            <li><a href="/over" class:list={[{ active: path.startsWith("/over") }]}>Over</a></li>
            <li><a href="/contact" class:list={[{ active: path.startsWith("/contact") }]} class="nav-cta">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="brand">
              <span class="brand-mark" aria-hidden="true"></span>
              <span class="brand-text">VDK<span class="brand-dash">-</span>Consulting</span>
            </div>
            <p class="footer-tagline">
              IT-partner voor ondernemingen die complexiteit willen wegnemen en
              groei willen versnellen.
            </p>
            <div class="footer-status">
              <span class="status-dot"></span>
              <span class="mono">Beschikbaar voor nieuwe projecten</span>
            </div>
          </div>

          <div class="footer-col">
            <h4>Diensten</h4>
            <ul>
              <li><a href="/diensten#webdesign">Webdesign</a></li>
              <li><a href="/diensten#netwerk">Netwerkinfrastructuur</a></li>
              <li><a href="/diensten#consultancy">IT Consultancy</a></li>
              <li><a href="/diensten#automatisering">Proces Automatisering</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Contact</h4>
            <ul>
              <li><a href="mailto:info@vdk-consulting.be">info@vdk-consulting.be</a></li>
              <li><a href="tel:+32483062307">+32 483 06 23 07</a></li>
              <li class="muted">België, GMT+1</li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span class="mono muted">© 2026 VDK-Consulting</span>
          <span class="mono muted">Alle rechten voorbehouden</span>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg: #050505;
        --surface: #0D0D0F;
        --surface-2: #14141A;
        --border: #1E1E24;
        --border-bright: #2A2A35;
        --text: #E6E6E6;
        --text-bright: #FFFFFF;
        --muted: #6B6B76;
        --muted-2: #4A4A55;
        --accent: #00D4FF;
        --accent-dim: #00A8CC;
        --accent-glow: rgba(0, 212, 255, 0.15);
        --accent-glow-strong: rgba(0, 212, 255, 0.35);
        --success: #00FF88;
        --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
        --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        --max-width: 1200px;
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .grid-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image:
          linear-gradient(rgba(0, 212, 255, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
        mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .mono {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        letter-spacing: -0.01em;
      }

      .muted { color: var(--muted); }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(5, 5, 5, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
      }

      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 64px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.9375rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .brand-mark {
        width: 3px;
        height: 22px;
        background: var(--accent);
        border-radius: 1px;
        box-shadow: 0 0 12px var(--accent-glow-strong);
      }

      .brand-text {
        color: var(--text-bright);
      }

      .brand-dash {
        color: var(--accent);
      }

      nav ul {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2rem;
        align-items: center;
      }

      nav a {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--muted);
        transition: color 0.15s ease;
        position: relative;
        padding: 6px 0;
      }

      nav a:hover {
        color: var(--text);
      }

      nav a.active {
        color: var(--accent);
      }

      nav a.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent);
      }

      nav a.nav-cta {
        color: var(--accent);
        padding: 6px 14px;
        border: 1px solid var(--accent);
        border-radius: 2px;
        transition: all 0.15s ease;
      }

      nav a.nav-cta:hover {
        background: var(--accent-glow);
        box-shadow: 0 0 20px var(--accent-glow);
      }

      nav a.nav-cta.active::after {
        display: none;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        font-weight: 500;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
        border-radius: 2px;
        line-height: 1;
      }

      .btn-primary {
        background: var(--accent);
        color: #000;
        font-weight: 600;
      }

      .btn-primary:hover {
        background: #22DFFF;
        box-shadow: 0 0 30px var(--accent-glow-strong);
        transform: translateY(-1px);
      }

      .btn-ghost {
        border-color: var(--border-bright);
        color: var(--text);
        background: transparent;
      }

      .btn-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(0, 212, 255, 0.05);
      }

      .btn-arrow::after {
        content: "→";
        transition: transform 0.15s ease;
      }

      .btn-arrow:hover::after {
        transform: translateX(4px);
      }

      /* Section eyebrow */
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .eyebrow::before {
        content: "";
        display: inline-block;
        width: 20px;
        height: 1px;
        background: var(--accent);
      }

      /* Sections */
      section {
        padding: 5rem 0;
        position: relative;
      }

      section + section {
        border-top: 1px solid var(--border);
      }

      /* Typography */
      h1, h2, h3 {
        font-family: var(--font-mono);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin: 0 0 1rem;
        color: var(--text-bright);
      }

      h1 {
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        font-weight: 700;
      }

      h2 {
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
      }

      h4 {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        font-weight: 500;
        margin: 0 0 1rem;
      }

      p {
        margin: 0 0 1.25rem;
        color: var(--muted);
        max-width: 65ch;
      }

      .highlight {
        color: var(--accent);
        font-weight: 600;
      }

      .cursor {
        display: inline-block;
        width: 0.5em;
        height: 1em;
        background: var(--accent);
        margin-left: 0.15em;
        animation: blink 1.2s infinite;
        vertical-align: text-bottom;
      }

      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 4rem 0 2rem;
        margin-top: 2rem;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
      }

      .footer-tagline {
        margin-top: 1.25rem;
        max-width: 400px;
        font-size: 0.9375rem;
      }

      .footer-status {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        color: var(--success);
        font-size: 0.75rem;
      }

      .status-dot {
        width: 8px;
        height: 8px;
        background: var(--success);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--success);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }

      .footer-col h4 {
        color: var(--accent);
        margin-bottom: 1rem;
        text-transform: none;
        letter-spacing: 0;
        font-size: 0.8125rem;
        font-family: var(--font-mono);
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer-col li {
        margin-bottom: 0.5rem;
        color: var(--muted);
        font-size: 0.875rem;
      }

      .footer-col a {
        transition: color 0.15s ease;
      }

      .footer-col a:hover {
        color: var(--accent);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        font-size: 0.75rem;
      }

      /* Mobile */
      @media (max-width: 768px) {
        nav ul { gap: 1rem; }
        nav a { font-size: 0.75rem; }
        nav a.nav-cta { padding: 4px 10px; }
        .brand { font-size: 0.8125rem; }
        section { padding: 3.5rem 0; }
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .footer-bottom {
          flex-direction: column;
          gap: 0.5rem;
          align-items: flex-start;
        }
      }

      *:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      ::selection {
        background: var(--accent);
        color: #000;
      }
    </style>
  </body>
</html>
