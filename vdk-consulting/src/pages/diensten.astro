---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: "webdesign",
    num: "01",
    title: "Webdesign",
    tagline: "Een website die werkt zoals uw bedrijf werkt.",
    description: "Van eenvoudige bedrijfssite tot volwaardige webshop met betalingsintegratie. We bouwen wat past bij uw doelen, geen sjabloon.",
    features: [
      "Responsive design (mobile-first)",
      "Integratie Mollie en andere betalingssystemen",
      "Onderhoud en support",
      "SEO fundamenten",
    ],
    tech: ["HTML", "CSS", "React", "Astro", "TypeScript", "Mollie"],
  },
  {
    id: "netwerk",
    num: "02",
    title: "Netwerkinfrastructuur",
    tagline: "Een netwerk dat u zelden hoeft op te merken.",
    description: "Betrouwbare bedrade en draadloze netwerken, correct gesegmenteerd en beveiligd. Voor kantoren, retail en industriële omgevingen.",
    features: [
      "Ontwerp en installatie",
      "Beveiligingsaudits",
      "Cloud migratie",
      "Preventief onderhoud",
    ],
    tech: ["Ubiquiti", "UniFi", "Linux", "VPN", "Firewall", "Tailscale"],
  },
  {
    id: "consultancy",
    num: "03",
    title: "IT Consultancy",
    tagline: "Advies dat verder gaat dan de offerte.",
    description: "Strategisch meedenken over uw IT-landschap. Kostenoptimalisatie, migratieplannen en tooling die past bij uw team.",
    features: [
      "IT strategy roadmaps",
      "Digitale transformatie",
      "Projectmanagement",
      "Training en support",
    ],
    tech: ["Roadmapping", "Change management", "Tooling audit"],
  },
  {
    id: "automatisering",
    num: "04",
    title: "Proces Automatisering",
    tagline: "Repetitief werk laten verdwijnen.",
    description: "Automatiseren van administratieve en operationele processen. Van simpele workflows tot integraties tussen systemen.",
    features: [
      "Workflow automatisering",
      "Systeem integraties",
      "Rapportage en dashboards",
      "Documenten en signeerflows",
    ],
    tech: ["Microsoft 365", "Azure", "Power Automate", "n8n", "APIs"],
  },
];
---

<Layout title="Diensten, VDK-Consulting">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Diensten</span>
      <h1>Vier vakgebieden.<br /><span class="highlight">Één aanspreekpunt.</span></h1>
      <p class="lead">
        Wat we doen, doen we goed. Elk vakgebied staat op zichzelf, en samen
        vormen ze een compleet IT-partnerschap voor uw onderneming.
      </p>
    </div>
  </section>

  <section class="services-list">
    <div class="container">
      {services.map((service) => (
        <article id={service.id} class="service-detail">
          <div class="service-meta">
            <div class="service-badge">
              <span class="mono">{service.num} / 04</span>
            </div>
            <h4>{service.title}</h4>
          </div>

          <div class="service-body">
            <h2>{service.title}</h2>
            <p class="service-tagline">{service.tagline}</p>
            <p>{service.description}</p>

            <div class="service-details">
              <div>
                <h4>Wat we leveren</h4>
                <ul class="feature-list">
                  {service.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h4>Stack</h4>
                <ul class="tech-list">
                  {service.tech.map((t) => (
                    <li class="mono">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <div>
        <span class="eyebrow">Volgende stap</span>
        <h2>Interesse in een <span class="highlight">concreet gesprek</span>?</h2>
        <p>
          Vertel ons over uw situatie. We denken vrijblijvend mee en geven
          eerlijk advies of we de juiste partner zijn.
        </p>
      </div>
      <a href="/contact" class="btn btn-primary btn-arrow">Plan een gesprek</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 5rem 0 3rem;
  }

  .page-header h1 {
    line-height: 1.05;
  }

  .page-header .lead {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 55ch;
    margin-top: 1.5rem;
    line-height: 1.7;
  }

  .services-list {
    padding-top: 2rem;
  }

  .service-detail {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .service-detail:last-of-type {
    border-bottom: 1px solid var(--border);
  }

  .service-meta {
    position: sticky;
    top: 90px;
    align-self: start;
  }

  .service-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 2px;
    font-size: 0.75rem;
    margin-bottom: 1rem;
  }

  .service-meta h4 {
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8125rem;
    margin: 0;
    font-family: var(--font-mono);
  }

  .service-body h2 {
    margin-bottom: 1rem;
    color: var(--text-bright);
  }

  .service-tagline {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--accent);
    line-height: 1.4;
    margin-bottom: 1.5rem;
    max-width: 40ch;
    font-weight: 500;
  }

  .service-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .feature-list li {
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--border);
    padding-left: 1.5rem;
    position: relative;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .feature-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .tech-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tech-list li {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.75rem;
    color: var(--text);
    border-radius: 2px;
    font-weight: 500;
  }

  .cta {
    background: linear-gradient(180deg, transparent 0%, rgba(0, 212, 255, 0.03) 100%);
    border-top: 1px solid var(--border);
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.4fr auto;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .service-detail {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 3rem 0;
    }
    .service-meta {
      position: static;
    }
    .service-details {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
