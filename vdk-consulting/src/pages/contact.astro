---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact, VDK-Consulting">
  <section class="page-header">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Vertel ons over<br />uw <span class="highlight">IT-uitdaging</span>.</h1>
      <p class="lead">
        Vul het formulier in en we nemen binnen 24 uur contact met u op. Of
        gebruik de directe kanalen hieronder, wat u het prettigst vindt.
      </p>
    </div>
  </section>

  <section class="contact-main">
    <div class="container contact-grid">
      <aside class="contact-info">
        <h4>Directe kanalen</h4>

        <div class="info-item">
          <span class="mono muted">Email</span>
          <a href="mailto:info@vdk-consulting.be">info@vdk-consulting.be</a>
        </div>

        <div class="info-item">
          <span class="mono muted">Telefoon</span>
          <a href="tel:+32483062307">+32 483 06 23 07</a>
        </div>

        <div class="info-item">
          <span class="mono muted">Locatie</span>
          <span>België, GMT+1</span>
        </div>

        <div class="info-item">
          <span class="mono muted">Reactie</span>
          <span>Binnen 24 uur op werkdagen</span>
        </div>

        <div class="info-status">
          <span class="status-dot"></span>
          <div>
            <div class="mono status-label">Beschikbaar</div>
            <div class="mono muted status-sub">Nieuwe projecten welkom</div>
          </div>
        </div>

        <div class="info-note">
          <h4>Nog niet klaar?</h4>
          <p>
            Lees eerst rustig door onze
            <a href="/diensten">diensten</a> of leer meer via
            <a href="/over">over ons</a>.
          </p>
        </div>
      </aside>

      <form class="contact-form" id="contactForm">
        <div class="form-header">
          <h4>Bericht opstellen</h4>
          <span class="mono muted form-status-inline" id="formStatusInline">Draft</span>
        </div>

        <input
          type="text"
          name="website_url"
          tabindex="-1"
          autocomplete="off"
          style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
          aria-hidden="true"
        />

        <div class="form-row">
          <label>
            <span class="mono muted">Naam <span class="required">*</span></span>
            <input type="text" name="naam" required />
          </label>
          <label>
            <span class="mono muted">Email <span class="required">*</span></span>
            <input type="email" name="email" required />
          </label>
        </div>

        <div class="form-row">
          <label>
            <span class="mono muted">Telefoon</span>
            <input type="tel" name="telefoon" />
          </label>
          <label>
            <span class="mono muted">Bedrijf</span>
            <input type="text" name="bedrijf" />
          </label>
        </div>

        <label>
          <span class="mono muted">Interesse</span>
          <select name="dienst">
            <option value="">Selecteer een dienst</option>
            <option value="webdesign">Webdesign</option>
            <option value="netwerkinfrastructuur">Netwerkinfrastructuur</option>
            <option value="it-consultancy">IT Consultancy</option>
            <option value="proces-automatisering">Proces Automatisering</option>
            <option value="anders">Anders / algemeen advies</option>
          </select>
        </label>

        <label>
          <span class="mono muted">Bericht <span class="required">*</span></span>
          <textarea name="bericht" rows="6" required placeholder="Vertel ons wat u wilt bereiken..."></textarea>
        </label>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-arrow" id="submitBtn">
            Verstuur bericht
          </button>
          <p class="form-note mono muted">
            Uw gegevens worden vertrouwelijk behandeld. Geen spam.
          </p>
        </div>

        <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const status = document.getElementById('formStatus');
  const statusInline = document.getElementById('formStatusInline');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  if (form && status && submitBtn && statusInline) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form).entries());

      submitBtn.disabled = true;
      submitBtn.textContent = 'Bezig...';
      statusInline.textContent = 'Bezig';
      statusInline.className = 'mono form-status-inline sending';
      status.className = 'form-status';
      status.textContent = '';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || 'Server error');
        }

        status.className = 'form-status success';
        status.textContent = 'Bedankt! We nemen binnen 24 uur contact met u op.';
        statusInline.textContent = 'Verzonden';
        statusInline.className = 'mono form-status-inline sent';
        form.reset();
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Er ging iets mis.';
        status.className = 'form-status error';
        status.innerHTML = `${msg} Mail rechtstreeks naar <a href="mailto:info@vdk-consulting.be">info@vdk-consulting.be</a> of bel <a href="tel:+32483062307">+32 483 06 23 07</a>.`;
        statusInline.textContent = 'Fout';
        statusInline.className = 'mono form-status-inline error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Verstuur bericht';
      }
    });
  }
</script>

<style>
  .page-header {
    padding: 5rem 0 3rem;
  }

  .page-header h1 {
    line-height: 1.05;
  }

  .page-header .lead {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 55ch;
    margin-top: 1.5rem;
    line-height: 1.7;
  }

  .contact-main {
    padding-top: 2rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-info h4 {
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-item a {
    color: var(--text);
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .info-item a:hover {
    color: var(--accent);
  }

  .info-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    margin: 1.5rem 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 2px solid var(--success);
    border-radius: 2px;
  }

  .status-label {
    color: var(--success);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .status-sub {
    font-size: 0.6875rem;
    margin-top: 0.125rem;
  }

  .info-note {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  .info-note h4 {
    margin-bottom: 0.75rem;
  }

  .info-note p {
    font-size: 0.875rem;
    margin: 0;
  }

  .info-note a {
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border 0.15s;
  }

  .info-note a:hover {
    border-bottom-color: var(--accent);
  }

  .contact-form {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
  }

  .form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }

  .form-header h4 {
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
  }

  .form-status-inline {
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
    border-radius: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .form-status-inline.sending {
    color: var(--accent);
    border-color: var(--accent);
  }

  .form-status-inline.sent {
    color: var(--success);
    border-color: var(--success);
  }

  .form-status-inline.error {
    color: #FF5555;
    border-color: #FF5555;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-form label span.mono {
    letter-spacing: 0;
    font-size: 0.75rem;
  }

  .required {
    color: var(--accent);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.75rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    border-radius: 2px;
    transition: all 0.15s ease;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form textarea::placeholder {
    color: var(--muted-2);
  }

  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .form-note {
    letter-spacing: 0;
    font-size: 0.75rem;
    text-transform: none;
  }

  .form-status {
    padding: 0;
    font-size: 0.875rem;
  }

  .form-status.success {
    padding: 0.875rem 1rem;
    background: rgba(0, 255, 136, 0.05);
    border: 1px solid rgba(0, 255, 136, 0.3);
    color: var(--success);
    border-radius: 2px;
  }

  .form-status.error {
    padding: 0.875rem 1rem;
    background: rgba(255, 85, 85, 0.05);
    border: 1px solid rgba(255, 85, 85, 0.3);
    color: #FF7777;
    border-radius: 2px;
  }

  .form-status a {
    color: inherit;
    text-decoration: underline;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form {
      padding: 1.5rem;
    }
  }
</style>
